{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/user/.herdr/worktrees/ukagai/verify-e1-e5/verification/hook.mjs",
            "timeout": 3600,
            "statusMessage": "ukagai: GUI で回答待ち"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/user/.herdr/worktrees/ukagai/verify-e1-e5/verification/hook.mjs",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
