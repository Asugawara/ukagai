{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/user/.herdr/worktrees/ukagai/verify-e1-e5/verification/hook.mjs",
            "timeout": 3600,
            "statusMessage": "ukagai: waiting for an answer in the GUI"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node /Users/user/.herdr/worktrees/ukagai/verify-e1-e5/verification/hook.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
