#!/bin/sh
# ukagai launcher: find our root through symlinks, find node >= 22, run dist/cli.js
set -eu

self=$0
case $self in
  /*) ;;
  */*) self="$(pwd)/$self" ;;
  *) self=$(command -v -- "$self" 2>/dev/null || printf '%s' "$self")
     case $self in /*) ;; *) self="$(pwd)/$self" ;; esac ;;
esac

# follow symlinks to the real file
f=$self
while [ -h "$f" ]; do
  target=$(readlink "$f")
  case $target in
    /*) f=$target ;;
    *) f="$(dirname "$f")/$target" ;;
  esac
done
root=$(cd "$(dirname "$f")/.." && pwd -P)

# run a command with a time limit when `timeout` exists
with_timeout() {
  secs=$1
  shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "$secs" "$@"
  else
    "$@"
  fi
}

# a candidate passes when it is executable and reports Node.js >= 22
node_ok() {
  cand=$1
  [ -n "$cand" ] && [ -x "$cand" ] || return 1
  v=$(with_timeout 5 "$cand" -p 'process.versions.node' 2>/dev/null) || return 1
  major=${v%%.*}
  case $major in
    '' | *[!0-9]*) return 1 ;;
  esac
  [ "$major" -ge 22 ]
}

# sortable key of the version found in a path (e.g. .../v22.3.1/bin/node -> 000022000003000001); empty when none
version_key() {
  key=
  oldifs=$IFS
  IFS=/
  set -f
  # shellcheck disable=SC2086
  set -- $1
  set +f
  IFS=$oldifs
  for part in "$@"; do
    part=${part#v}
    case $part in
      [0-9]*.[0-9]*.[0-9]*)
        maj=${part%%.*}
        rest=${part#*.}
        min=${rest%%.*}
        pat=${rest#*.}
        pat=${pat%%[!0-9]*}
        case $maj$min$pat in
          '' | *[!0-9]*) continue ;;
        esac
        key=$(printf '%06d%06d%06d' "$maj" "$min" "$pat")
        ;;
    esac
  done
  printf '%s' "$key"
}

# newest of the version-named candidates given
newest_of() {
  best=
  bestkey=0
  for c in "$@"; do
    [ -x "$c" ] || continue
    k=$(version_key "$c")
    k=${k:-0}
    if [ -z "$best" ] || [ "$k" -gt "$bestkey" ]; then
      best=$c
      bestkey=$k
    fi
  done
  printf '%s' "$best"
}

find_node() {
  if [ -n "${UKAGAI_NODE:-}" ] && node_ok "$UKAGAI_NODE"; then
    printf '%s' "$UKAGAI_NODE"
    return 0
  fi

  np="${UKAGAI_DATA_DIR:-${HOME:-}/.ukagai}/node-path"
  if [ -f "$np" ]; then
    cand=
    read -r cand <"$np" 2>/dev/null || true
    if node_ok "$cand"; then
      printf '%s' "$cand"
      return 0
    fi
  fi

  cand=$(command -v node 2>/dev/null || true)
  if node_ok "$cand"; then
    printf '%s' "$cand"
    return 0
  fi

  h=${HOME:-}
  if [ -n "$h" ]; then
    for pattern in \
      "$h/.nvm/versions/node/*/bin/node" \
      "$h/.local/share/nvm/*/bin/node" \
      "$h/.local/share/fnm/node-versions/*/installation/bin/node" \
      "$h/.local/share/mise/installs/node/*/bin/node"; do
      # shellcheck disable=SC2086
      set -- $pattern
      [ -e "$1" ] || continue
      cand=$(newest_of "$@")
      if node_ok "$cand"; then
        printf '%s' "$cand"
        return 0
      fi
    done
    if node_ok "$h/.volta/bin/node"; then
      printf '%s' "$h/.volta/bin/node"
      return 0
    fi
  fi
  for cand in /opt/homebrew/bin/node /usr/local/bin/node; do
    if node_ok "$cand"; then
      printf '%s' "$cand"
      return 0
    fi
  done

  if [ -n "${SHELL:-}" ] && [ -x "$SHELL" ]; then
    out=$(with_timeout 10 "$SHELL" -lc 'command -v node' 2>/dev/null </dev/null || true)
    cand=${out##*
}
    if node_ok "$cand"; then
      printf '%s' "$cand"
      return 0
    fi
  fi
  return 1
}

if ! node=$(find_node); then
  if [ "${1:-}" = hook ]; then
    input=$(cat 2>/dev/null || true)
    case $input in
      *'hook_event_name":"SessionStart"'* | *'hook_event_name": "SessionStart"'*)
        echo 'ukagai: Node.js 22 or newer was not found; the ukagai hooks are inactive. Re-run install.sh or set UKAGAI_NODE.'
        ;;
    esac
    exit 0
  fi
  echo 'ukagai: node (>= 22) not found: set UKAGAI_NODE or put node on PATH' >&2
  exit 127
fi

UKAGAI_LAUNCHER=$self
export UKAGAI_LAUNCHER
exec "$node" "$root/dist/cli.js" "$@"
