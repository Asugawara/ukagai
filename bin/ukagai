#!/bin/sh
# ukagai launcher: find our root through symlinks, find node >= 22, run dist/cli.js
set -eu

self=$0
case $self in
  /*) ;;
  */*) self="$(pwd)/$self" ;;
  *) self=$(command -v -- "$self" 2>/dev/null || printf '%s' "$self")
     case $self in /*) ;; *) self="$(pwd)/$self" ;; esac ;;
esac

# follow symlinks to the real file
f=$self
while [ -h "$f" ]; do
  target=$(readlink "$f")
  case $target in
    /*) f=$target ;;
    *) f="$(dirname "$f")/$target" ;;
  esac
done
root=$(cd "$(dirname "$f")/.." && pwd -P)

# run a command with a time limit (macOS has no `timeout`: use a background watchdog)
with_timeout() {
  secs=$1
  shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "$secs" "$@"
  else
    (
      "$@" &
      p=$!
      (
        sleep "$secs"
        kill "$p" 2>/dev/null
      ) >/dev/null 2>&1 &
      w=$!
      wait "$p"
      r=$?
      kill "$w" 2>/dev/null
      exit "$r"
    )
  fi
}

# a candidate passes when it is executable and reports Node.js >= 22
node_ok() {
  cand=$1
  [ -n "$cand" ] && [ -x "$cand" ] || return 1
  v=$(with_timeout 5 "$cand" -p 'process.versions.node' 2>/dev/null) || return 1
  major=${v%%.*}
  case $major in
    '' | *[!0-9]*) return 1 ;;
  esac
  [ "$major" -ge 22 ]
}

# Fast path for the hooks: a node that passed node_ok once is remembered in <data-dir>/node-ok (line 1: its path,
# line 2: a fingerprint), so the next call can exec it without the version probe (two node starts plus a watchdog on
# macOS). The note is trusted only while the path is the same, the fingerprint (the real path behind the symlinks plus
# the `ls -lLi` line of that file) is the same and the note is under a day old. Anything missing or failing means probe.
# Shims (not named node, under /shims/, or a script) pick a node per directory, so they are never noted.
# A node broken in place (e.g. a dylib it loads was removed) keeps its fingerprint: the day limit bounds that case.
okfile="${UKAGAI_DATA_DIR:-${HOME:-}/.ukagai}/node-ok"

# follow the symlinks of $1 to the real file (sets real); fails on a loop or a missing readlink
resolve_real() {
  real=$1
  hops=0
  while [ -h "$real" ]; do
    hops=$((hops + 1))
    [ "$hops" -le 40 ] || return 1
    target=$(readlink "$real") || return 1
    case $target in
      /*) real=$target ;;
      *)
        case $real in
          */*) real="${real%/*}/$target" ;;
          *) real=$target ;;
        esac
        ;;
    esac
  done
}

# fingerprint of the node behind $1 (sets real and fp); fails for a shim or when a tool is missing
node_fp() {
  fp=
  resolve_real "$1" || return 1
  case $1 in */shims/*) return 1 ;; esac
  case $real in */shims/*) return 1 ;; esac
  [ "${real##*/}" = node ] || return 1
  # fixed locale and zone: the date in the line must not change with the caller's environment
  line=$(LC_ALL=C TZ=UTC0 ls -lLi "$real" 2>/dev/null) || return 1
  [ -n "$line" ] || return 1
  fp="$real $line"
}

known_good() {
  cand=$1
  [ -n "$cand" ] && [ -x "$cand" ] && [ -f "$okfile" ] || return 1
  noted=
  notedfp=
  { read -r noted && read -r notedfp; } <"$okfile" 2>/dev/null || true
  [ "$noted" = "$cand" ] && [ -n "$notedfp" ] || return 1
  node_fp "$cand" || return 1
  [ "$fp" = "$notedfp" ] || return 1
  stale=$(find "$okfile" -mtime +0 2>/dev/null) || return 1
  [ -z "$stale" ]
}

# remember a node that passed node_ok, unless it is a shim or a script
note_good() {
  node_fp "$1" || return 0
  magic=$(dd if="$real" bs=1 count=2 2>/dev/null) || return 0
  [ "$magic" != '#!' ] || return 0
  { printf '%s\n%s\n' "$1" "$fp" >"$okfile.$$" && mv -f "$okfile.$$" "$okfile"; } 2>/dev/null || rm -f "$okfile.$$" 2>/dev/null || true
}

# probe a configured node (UKAGAI_NODE, node-path) unless it is already known good; remember it when it passes
check_configured() {
  known_good "$1" && return 0
  node_ok "$1" || return 1
  note_good "$1"
  return 0
}

# sortable key of the version found in a path (e.g. .../v22.3.1/bin/node -> 000022000003000001); empty when none
version_key() {
  key=
  oldifs=$IFS
  IFS=/
  set -f
  # shellcheck disable=SC2086
  set -- $1
  set +f
  IFS=$oldifs
  for part in "$@"; do
    part=${part#v}
    case $part in
      [0-9]*.[0-9]*.[0-9]*)
        maj=${part%%.*}
        rest=${part#*.}
        min=${rest%%.*}
        pat=${rest#*.}
        pat=${pat%%[!0-9]*}
        case $maj$min$pat in
          '' | *[!0-9]*) continue ;;
        esac
        key=$(printf '%06d%06d%06d' "$maj" "$min" "$pat")
        ;;
    esac
  done
  printf '%s' "$key"
}

# newest of the version-named candidates given
newest_of() {
  best=
  bestkey=0
  for c in "$@"; do
    [ -x "$c" ] || continue
    k=$(version_key "$c")
    k=${k:-0}
    if [ -z "$best" ] || [ "$k" -gt "$bestkey" ]; then
      best=$c
      bestkey=$k
    fi
  done
  printf '%s' "$best"
}

find_node() {
  if [ -n "${UKAGAI_NODE:-}" ] && check_configured "$UKAGAI_NODE"; then
    printf '%s' "$UKAGAI_NODE"
    return 0
  fi

  np="${UKAGAI_DATA_DIR:-${HOME:-}/.ukagai}/node-path"
  if [ -f "$np" ]; then
    cand=
    read -r cand <"$np" 2>/dev/null || true
    if check_configured "$cand"; then
      printf '%s' "$cand"
      return 0
    fi
  fi

  cand=$(command -v node 2>/dev/null || true)
  if node_ok "$cand"; then
    printf '%s' "$cand"
    return 0
  fi

  h=${HOME:-}
  if [ -n "$h" ]; then
    for pattern in \
      "$h/.nvm/versions/node/*/bin/node" \
      "$h/.local/share/nvm/*/bin/node" \
      "$h/.local/share/fnm/node-versions/*/installation/bin/node" \
      "$h/Library/Application Support/fnm/node-versions/*/installation/bin/node" \
      "$h/.local/share/mise/installs/node/*/bin/node"; do
      # split on newlines only: a pattern may contain spaces ("Application Support")
      oldifs=$IFS
      IFS='
'
      # shellcheck disable=SC2086
      set -- $pattern
      IFS=$oldifs
      [ -e "$1" ] || continue
      cand=$(newest_of "$@")
      if node_ok "$cand"; then
        printf '%s' "$cand"
        return 0
      fi
    done
    if node_ok "$h/.volta/bin/node"; then
      printf '%s' "$h/.volta/bin/node"
      return 0
    fi
  fi
  for cand in /opt/homebrew/bin/node /usr/local/bin/node; do
    if node_ok "$cand"; then
      printf '%s' "$cand"
      return 0
    fi
  done

  if [ -n "${SHELL:-}" ] && [ -x "$SHELL" ]; then
    out=$(with_timeout 5 "$SHELL" -lc 'command -v node' 2>/dev/null </dev/null || true)
    cand=${out##*
}
    if node_ok "$cand"; then
      printf '%s' "$cand"
      return 0
    fi
  fi
  return 1
}

if ! node=$(find_node); then
  if [ "${1:-}" = hook ]; then
    input=$(cat 2>/dev/null || true)
    # accept optional whitespace around ":" (pretty-printed JSON)
    flat=$(printf '%s' "$input" | tr -d ' \t')
    case $flat in
      *'hook_event_name":"SessionStart"'*)
        echo 'ukagai: Node.js 22 or newer was not found; the ukagai hooks are inactive. Re-run install.sh or set UKAGAI_NODE.'
        ;;
    esac
    exit 0
  fi
  echo 'ukagai: node (>= 22) not found: set UKAGAI_NODE or put node on PATH' >&2
  exit 127
fi

UKAGAI_LAUNCHER=$self
export UKAGAI_LAUNCHER
exec "$node" "$root/dist/cli.js" "$@"
